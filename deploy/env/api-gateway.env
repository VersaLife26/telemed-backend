# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.
#
# The gateway has no database of its own -- there is deliberately no
# DATABASE_URL, no NATS_*, no OUTBOX_* here. It needs Redis and the Keycloak
# JWKS, nothing more.

SERVICE_NAME=telemed-api-gateway
ENV=dev
HTTP_PORT=8080
LOG_LEVEL=debug

# --- Redis --------------------------------------------------------------
# Rate-limit counters and circuit-breaker state, shared across every replica.
REDIS_URL=redis://localhost:6379
# The dev stack now runs Redis with `requirepass telemed-dev-redis`
# (telemed-infra). This value must match it or every cache call fails with
# NOAUTH at boot.
#
# It is committed on purpose, following BANK_ENCRYPTION_KEY's precedent: an
# empty value here makes the documented `cp .env.example .env && make run`
# Quick Start fail, and a Quick Start that does not work is how a developer
# ends up running the stack with the control switched off. It is a DEV value
# and it is not safe anywhere else -- Redis holds OTP hashes and every
# rate-limit counter, so an unauthenticated Redis means `DEL
# otp:verify_attempts:*` removes the OTP brute-force cap.
#
# cache.Options treats this as an override on top of REDIS_URL, so a password
# embedded in the URL (redis://:pw@host) is replaced when this is set.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- Authentication: TWO issuers, both trusted (ADR-010) ---------------------
# telemed-user-service signs patient and doctor tokens -- phone-OTP login must
# keep working when Keycloak is down. Keycloak signs admin tokens, where SAML
# SSO and enforced 2FA justify the hard dependency.
#
# A token is accepted only when its signature verifies against ONE of these key
# sets AND its "iss" claim is on the trusted list. Configuring Keycloak alone
# rejects every patient and doctor token with a signature error.
#
# USER_ISSUER is the literal "iss" claim user-service mints -- its JWT_ISSUER,
# NOT its base URL. Change it here only if you change it there.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs

# --- Client IP resolution (security) -----------------------------------------
# CIDRs whose X-Forwarded-For / X-Real-IP headers are believed. Requests from
# anywhere else have their client address taken from the TCP peer, which no
# header can forge. chi's middleware.RealIP is deprecated for exactly this
# reason (GHSA-3fxj-6jh8-hvhx) and the admin IP allowlist depends on the value.
# Empty means "private ranges only" (127/8, ::1, 10/8, 172.16/12, 192.168/16,
# fc00::/7). In production, set your ingress/load-balancer ranges explicitly.
TRUSTED_PROXIES=

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
# Ceiling for every request; the route table's own fast/write/upload classes
# (5s/15s/60s) apply underneath this and are almost always tighter. Keep this
# above 60s or the upload class gets silently clipped.
REQUEST_TIMEOUT=65s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo

# --- Route table --------------------------------------------------------
# Empty means "use the table embedded in the binary" (config/routes.json at
# build time). Point this at a file on disk to add or change a route without
# rebuilding the image.
ROUTES_FILE=

# --- Upstream backend services (the brief's port table) ---------------------
UPSTREAM_USER_URL=http://localhost:8081
UPSTREAM_DOCTOR_URL=http://localhost:8082
UPSTREAM_SCHEDULING_URL=http://localhost:8083
UPSTREAM_CONSULTATION_URL=http://localhost:8084
UPSTREAM_PAYMENT_URL=http://localhost:8085
UPSTREAM_NOTIFICATION_URL=http://localhost:8086
UPSTREAM_RECORD_URL=http://localhost:8087
UPSTREAM_ADMIN_URL=http://localhost:8088

# --- CORS -------------------------------------------------------------------
# Three distinct origin lists. Never merge patient and admin: that is exactly
# the mistake that makes the admin surface reachable from a patient browser
# tab. Comma-separated.
CORS_PATIENT_ORIGINS=https://patient.yourapp.lk
CORS_DOCTOR_ORIGINS=https://doctor.yourapp.lk
CORS_ADMIN_ORIGINS=https://admin.yourapp.lk

# --- Admin surface ------------------------------------------------------
# CIDRs allowed onto /api/v1/admin/*, in addition to admin-service's own
# allowlist (belt and braces). Empty disables the allowlist check (dev only;
# the deployment MUST set this in staging/prod).
ADMIN_IP_ALLOWLIST=

# --- Resilience ---------------------------------------------------------
# Total concurrent proxied requests before the gateway sheds load with 503.
MAX_IN_FLIGHT=2000
# Consecutive upstream failures before a circuit breaker opens.
CIRCUIT_FAILURE_THRESHOLD=5
# How long a breaker stays fully open before allowing one probe request.
CIRCUIT_OPEN_SECONDS=30
# How long a single probe has to report back before another caller may try.
CIRCUIT_PROBE_SECONDS=5

# --- Body size caps, bytes ------------------------------------------------
MAX_BODY_BYTES_FAST=1048576
MAX_BODY_BYTES_WRITE=4194304
MAX_BODY_BYTES_UPLOAD=15728640
