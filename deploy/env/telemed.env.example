# The whole platform's development environment, in one file.
#
# cmd/telemed is one process running every domain, so it reads ONE environment.
# This file is the merge of the nine per-service examples that preceded it;
# those are kept alongside for a split deployment (TELEMED_DOMAINS=user and so
# on), which still wants a per-domain file.
#
# NOT FOR PRODUCTION. Every value here is a development default -- the point is
# that `make bootstrap` works with no setup. Real deployments take their secrets
# from /etc/telemed/secrets.env (scripts/gen-secrets.sh in telemed-infra), and
# every one of those overrides what is written here: a real environment
# variable beats this file in viper.
#
# THIS IS NOT A SHELL SCRIPT. Values are raw, unquoted, and several of them
# contain characters a shell would choke on -- JSON in COMMISSION_RULES, a cron
# expression in PAYOUT_SCHEDULE, parentheses in INVOICE_COMPANY_NAME. Read it
# with a KEY=VALUE parser, never with `source`.
#
# WHAT IS DELIBERATELY ABSENT
#   SERVICE_NAME, HTTP_PORT, GRPC_PORT  -- one process, one identity, one port.
#   DATABASE_URL                        -- derived per domain by cmd/telemed,
#                                          which swaps in telemed_<domain>_app
#                                          and pins search_path to svc_<domain>.

# The domains this process runs. "all" is every one of them plus the edge.
TELEMED_DOMAINS=all

# gRPC listeners stay off: in one process the domains resolve each other
# in-process, and user-service's gRPC surface is a full PII directory.
EXPOSE_GRPC=false

# Eight pools in one process, not twenty connections each.
DB_MAX_CONNS_PER_DOMAIN=8

ENV=dev
LOG_LEVEL=debug
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h
REDIS_URL=redis://localhost:6379
