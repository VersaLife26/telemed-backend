# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.

SERVICE_NAME=telemed-admin-service
ENV=dev
HTTP_PORT=8088
GRPC_PORT=9098
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# EVERY environment, including this one, connects as telemed_admin_app: the
# least-privilege runtime role. It owns nothing, so it cannot DROP a table,
# ALTER one, disable a trigger, or TRUNCATE audit_logs -- which is what makes
# the REVOKEs in migrations/000002 and 000009 enforcement rather than
# decoration (security review F14). Connecting as the owner, which this file
# used to do "for local dev convenience", meant the append-only guarantee
# rested entirely on the triggers, and TRUNCATE fires none of them.
#
# Migrations are a SEPARATE role, telemed_admin_migrate, which owns the schema:
#   make migrate-up   (uses MIGRATE_DATABASE_URL in the Makefile)
#
# Both roles are created by telemed-infra's Postgres init on first boot, with
# TELEMED_DB_ROLE_PASSWORD (default: the dev password below). See
# telemed-infra/docs/DATABASE-ROLES.md.
#
# Port 5433, not 5432: telemed-infra publishes Postgres on the host at 5433
# so it does not clash with a host-level Postgres already occupying 5432.
# Inside docker-compose, services still reach it at postgres:5432. See
# telemed-infra/README.md and _shared/INTEGRATION-FIXES.md item 1.
DATABASE_URL=postgres://telemed_admin_app:telemed@localhost:5433/telemed_admin?sslmode=require
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# The dev value the infra stack sets with `requirepass`. It is NOT optional any
# more: Redis holds OTP hashes, every rate-limit counter and the suspension
# denylist, so an unauthenticated Redis means `DEL otp:verify_attempts:*`
# removes the OTP brute-force cap. If REDIS_URL already embeds a password this
# value wins -- cache.NewRedis overrides opt.Password whenever it is non-empty.
#
# Ordering matters: go-redis sends AUTH whenever this is non-empty, and a Redis
# WITHOUT requirepass answers AUTH with an error, so the service fails its
# startup ping. Set this only once telemed-infra's Redis actually requires a
# password; until then leave it empty.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- NATS JetStream ---------------------------------------------------------
# Credentials go INSIDE the URL. internal/platform/events reads only NATS_URL
# and nats.Connect parses the userinfo out of it -- there is no NATS_PASSWORD
# binding, so adding one would silently do nothing. NATS now carries an
# authorization{} block; before it, anything that could reach :4222 could
# subscribe to telemed.> and read every domain event on the platform.
NATS_URL=nats://telemed:telemed-dev-nats@localhost:4222
NATS_STREAM=TELEMED
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- Authentication: TWO issuers, both trusted (ADR-010) ---------------------
# telemed-user-service signs patient and doctor tokens -- phone-OTP login must
# keep working when Keycloak is down. Keycloak signs admin tokens, where SAML
# SSO and enforced 2FA justify the hard dependency.
#
# A token is accepted only when its signature verifies against ONE of these key
# sets AND its "iss" claim is on the trusted list. Configuring Keycloak alone
# rejects every patient and doctor token with a signature error.
#
# USER_ISSUER is the literal "iss" claim user-service mints -- its JWT_ISSUER,
# NOT its base URL. Change it here only if you change it there.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs

# --- Client IP resolution (security) -----------------------------------------
# CIDRs whose X-Forwarded-For / X-Real-IP headers are believed. Requests from
# anywhere else have their client address taken from the TCP peer, which no
# header can forge. chi's middleware.RealIP is deprecated for exactly this
# reason (GHSA-3fxj-6jh8-hvhx) and the admin IP allowlist depends on the value.
# Empty means "private ranges only" (127/8, ::1, 10/8, 172.16/12, 192.168/16,
# fc00::/7). In production, set your ingress/load-balancer ranges explicitly.
TRUSTED_PROXIES=

# --- Identity resolution -----------------------------------------------------
# The user and doctor-credentialing projections resolve names, emails and
# phones from user-service. The canonical user.registered and doctor.registered
# payloads deliberately do not carry them -- a full phone number is
# PHI-adjacent and those events fan out to every consumer -- so they are
# fetched per user over user-service's internal gRPC surface (ADR-004).
USER_SERVICE_GRPC_ADDR=localhost:9091

# doctor-service HTTP base for public-application approve/reject (SoR).
DOCTOR_SERVICE_URL=http://localhost:8082
# This gRPC hop carries names, phone numbers and email addresses. It has always
# been plaintext, justified by "the mesh is private" -- true of a single-host
# compose deployment, and a reasonable position, but it was the only position
# available.
#
# It is now a decision. Plaintext remains the default so the current deployment
# keeps working, but a PRODUCTION service refuses to boot on plaintext unless
# USER_SERVICE_GRPC_ALLOW_PLAINTEXT is set deliberately: an unset variable must
# not silently mean unencrypted PII across the cluster (that is F17's shape).
#
# mTLS is deliberately out of scope: it needs a CA and a rotation story that do
# not exist yet, and user-service presents no gRPC server credentials.
# Server-authenticated TLS is what this side can deliver alone, and it closes
# passive interception.
USER_SERVICE_GRPC_TLS=false
USER_SERVICE_GRPC_CA_FILE=
USER_SERVICE_GRPC_SERVER_NAME=
USER_SERVICE_GRPC_ALLOW_PLAINTEXT=false
USER_LOOKUP_TIMEOUT_SECONDS=3

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=30s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo

# --- Admin surface ------------------------------------------------------
# Comma-separated CIDRs (office + VPN). Empty means "not configured", which
# middleware.IPAllowlist treats as OPEN -- fine for dev, and with ENV=prod the
# service now REFUSES TO BOOT rather than serving the credentialing queue to
# whatever can reach the pod (security review F17). Malformed entries are
# rejected at boot too: middleware.IPAllowlist silently SKIPS one, so two typos
# produce an empty list from a variable that looks configured.
#
# A bare address is taken as /32 (or /128 for IPv6). Individual admins can be
# scoped narrower still via admin_users.ip_allowlist (see internal/adminusers).
ADMIN_IP_ALLOWLIST=

# --- MinIO (doctor credentialing document viewer) ---------------------------
# This service only ever presigns GET URLs for documents doctor-service
# already uploaded; it never writes to MinIO.
MINIO_ENDPOINT=localhost:9000
# Must match telemed-infra's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD defaults.
MINIO_ACCESS_KEY=telemed-admin
MINIO_SECRET_KEY=telemed-dev-secret
MINIO_USE_SSL=false
# telemed-infra creates doctor-credentials, not doctor-documents. The old value
# named a bucket that does not exist, so every presigned credential-document
# URL in the verification queue would have failed.
MINIO_DOCTOR_DOCS_BUCKET=doctor-credentials
# How long a credential-document URL stays usable. This is a data-exposure
# setting, not a convenience knob: the URL is a bearer credential for a scanned
# NIC or SLMC certificate, and anyone who ends up holding the link holds the
# document until it lapses. Hard-capped at 15m in credentialing.NewService --
# a larger value here is silently clamped, not honoured.
DOC_PRESIGN_TTL=5m
