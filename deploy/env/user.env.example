# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.

SERVICE_NAME=telemed-user-service
ENV=dev
HTTP_PORT=8081
GRPC_PORT=9091
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Port 5433, not 5432: telemed-infra publishes Postgres on the host at 5433 so
# it does not clash with a host-level Postgres already occupying 5432. Inside
# docker-compose, services still reach it at postgres:5432. See
# telemed-infra/README.md and _shared/INTEGRATION-FIXES.md item 1.
#
# sslmode=require, not disable: telemed-infra now runs Postgres with ssl=on and
# a TLS 1.2 minimum. `require` encrypts the connection but does NOT verify the
# server certificate -- the dev stack uses a self-signed one, so verify-full
# would fail. A production DSN must use verify-full with a real CA, because
# `require` alone is transport encryption without authentication and does not
# stop an active attacker.
#
# Set TELEMED_PG_SSLMODE=disable in telemed-infra to revert the server side if
# a local tool cannot speak TLS; this line has to match whatever the server is
# doing.
DATABASE_URL=postgres://telemed:telemed@localhost:5433/telemed_user?sslmode=require
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# The dev stack now runs Redis with `requirepass telemed-dev-redis`
# (telemed-infra). This value must match it or every cache call fails with
# NOAUTH at boot.
#
# It is committed on purpose, following BANK_ENCRYPTION_KEY's precedent: an
# empty value here makes the documented `cp .env.example .env && make run`
# Quick Start fail, and a Quick Start that does not work is how a developer
# ends up running the stack with the control switched off. It is a DEV value
# and it is not safe anywhere else -- Redis holds OTP hashes and every
# rate-limit counter, so an unauthenticated Redis means `DEL
# otp:verify_attempts:*` removes the OTP brute-force cap.
#
# cache.Options treats this as an override on top of REDIS_URL, so a password
# embedded in the URL (redis://:pw@host) is replaced when this is set.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- NATS JetStream ---------------------------------------------------------
# The credentials go INSIDE the URL, and there is no alternative.
#
# NATS had no authorization block at all before the infra hardening (security
# review F30): anything that could open a TCP connection to :4222 could
# subscribe to `telemed.>` and read every domain event on the platform --
# appointment.created, consultation.*, payment.*, the lot.
#
# There is deliberately no NATS_USER / NATS_PASSWORD here. config.Base binds
# nats_url, nats_stream, nats_credentials and nats_max_bytes and nothing else,
# and events.NewNATS passes only o.URL to nats.Connect, which parses the
# userinfo out of it. Adding NATS_PASSWORD would bind to nothing and fail
# SILENTLY -- the service would connect anonymously and be refused, or worse,
# connect to a server that had not yet been hardened.
#
# NATS_CREDENTIALS is the other supported path (a .creds file, for NATS
# accounts/JWT) and is what a production deployment should use instead of
# userinfo in a URL.
NATS_URL=nats://telemed:telemed-dev-nats@localhost:4222
NATS_STREAM=TELEMED
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- Keycloak ---------------------------------------------------------------
# Two distinct uses, and only one of them is the identity mirror:
#
#   1. Identity mirror (KEYCLOAK_BASE_URL / _REALM / _ADMIN_*). Best effort.
#      Leave KEYCLOAK_ADMIN_CLIENT_ID empty to run with no Keycloak at all: the
#      service degrades to a no-op mirror and OTP login still works.
#   2. Verifying SERVICE tokens on the gRPC surface (KEYCLOAK_ISSUER /
#      KEYCLOAK_JWKS_URL). These are now load-bearing. The gRPC server on
#      GRPC_PORT requires a Keycloak-issued token carrying the "service" role
#      on every method, and with these unset -- or with the key set
#      unreachable at boot -- it REFUSES EVERY CALL with UNAVAILABLE rather
#      than serving the user directory unauthenticated. HTTP and OTP login are
#      unaffected either way, which is the point: an identity-provider outage
#      must never stop a patient reaching a doctor.
#
# These are NOT used to verify this service's own patient/doctor tokens -- see
# JWT_* below and README "50-Year Maintenance".
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=telemedicine
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- JWT signing (this service issues its own access/refresh tokens) -------
# PEM-encoded RSA private key (PKCS#1 or PKCS#8). Leave empty in dev: an
# ephemeral key is generated per-process (tokens stop verifying on restart).
# REQUIRED in ENV=prod -- boot fails fast rather than silently rotating keys
# on every deploy.
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=user-service-1
JWT_ISSUER=telemed-user-service
JWT_AUDIENCE=telemed-api

# --- NIC hashing -------------------------------------------------------------
# The secret pepper for HMAC-SHA256(NIC). At least 32 bytes.
#
# It is held HERE, outside the database, on purpose. A Sri Lankan NIC encodes
# its own birth date (old YYDDDNNNNC, new YYYYDDDNNNNN) and family_members
# stores the plaintext dob in the same row, so a database dump alone narrows a
# NIC to ~10^4 candidates. bcrypt -- what this column used to be -- buys time
# per guess, which is worth nothing against a search space that small. A key
# the dump does not contain is worth everything.
#
# Leave empty in dev: an ephemeral pepper is generated per process, and stored
# digests stop matching after a restart. REQUIRED in ENV=prod, because there a
# silent rotation would break duplicate detection and NIC confirmation for
# every row already written.
#
# Generate with:
#   openssl rand -hex 32
NIC_HASH_PEPPER=

# The pepper generation stamped into nic_hash_version on every digest this
# process writes. Bump it in the SAME change that replaces NIC_HASH_PEPPER,
# never separately -- the column exists so a digest names the key that produced
# it, and a new pepper under the old version number destroys that.
NIC_HASH_PEPPER_VERSION=1

# Superseded peppers, for the window in which old rows have not yet been
# rewritten. Comma-separated "<version>:<pepper>". Verification only: nothing is
# ever written under a retired pepper, so a rotation always moves forward.
#
# ROTATING THE PEPPER, in order:
#   1. Generate a new one. Set NIC_HASH_PEPPER to it, bump
#      NIC_HASH_PEPPER_VERSION, and move the OLD value here as "1:<old>".
#   2. Deploy. New digests are written at the new version; rows still at the old
#      version keep verifying, because Matches selects the pepper by the row's
#      own nic_hash_version.
#   3. Rewrite the remaining rows. The column makes them countable:
#        SELECT count(*) FROM family_members WHERE nic_hash_version = 1;
#   4. When that reaches zero, drop the old entry from here.
#
# Skipping step 1 is what this whole mechanism exists to prevent. Before the
# version column, replacing the pepper made every stored digest stop matching
# with no error and no log line -- duplicate detection simply found nothing,
# which is also what it does when there is genuinely no duplicate.
NIC_HASH_PEPPER_PREVIOUS=

# --- SMS delivery ------------------------------------------------------------
# dev | dialog | twilio. Defaults to dev (prints the OTP to the console) when
# the selected provider has no credentials configured. Refused in ENV=prod.
SMS_PROVIDER=dev

# doctor-service HTTP base used during OTP verify to attach approved applications.
DOCTOR_SERVICE_URL=http://localhost:8082

DIALOG_BASE_URL=https://api.dialog.lk/sms
DIALOG_APPLICATION_ID=
DIALOG_PASSWORD=
DIALOG_SOURCE_ADDRESS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- PDPA erasure reaper -----------------------------------------------------
ERASURE_INTERVAL_MINUTES=60
ERASURE_BATCH_SIZE=200

# --- Trusted token issuers (ADR-010) -----------------------------------------
# The platform has TWO issuers and every service accepts both:
#   - telemed-user-service signs patient and doctor tokens (this service).
#   - Keycloak signs admin tokens.
# USER_ISSUER must equal the "iss" claim this service actually mints, which is
# JWT_ISSUER above -- NOT the service's base URL. Getting this wrong rejects
# every patient and doctor token with an untrusted-issuer error.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# --- Client IP resolution (security) -----------------------------------------
# CIDRs whose X-Forwarded-For / X-Real-IP headers are believed. Requests from
# anywhere else have their client IP taken from the TCP peer address, which no
# header can forge. This feeds the OTP rate limiter and the admin IP allowlist,
# so an empty-but-permissive value would be a bypass, not a convenience.
# Empty means "private ranges only" (127/8, ::1, 10/8, 172.16/12, 192.168/16,
# fc00::/7). In production set this to your ingress/LB ranges explicitly.
TRUSTED_PROXIES=

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=30s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo
