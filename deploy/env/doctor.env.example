# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.

SERVICE_NAME=telemed-doctor-service
ENV=dev
HTTP_PORT=8082
GRPC_PORT=9092
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Port 5433, not 5432: telemed-infra publishes Postgres there so it does not
# clash with a host-level Postgres already holding 5432. Container-to-container
# traffic still uses postgres:5432 and is unaffected -- this line is only read
# when the service runs on the host (`make run`).
#
# sslmode=require, not disable: telemed-infra now runs Postgres with ssl=on and
# a TLS 1.2 minimum. `require` encrypts the connection but does NOT verify the
# server certificate -- the dev stack uses a self-signed one, so verify-full
# would fail. A production DSN must use verify-full with a real CA, because
# `require` alone is transport encryption without authentication and does not
# stop an active attacker.
#
# Set TELEMED_PG_SSLMODE=disable in telemed-infra to revert the server side if
# a local tool cannot speak TLS; this line has to match whatever the server is
# doing.
DATABASE_URL=postgres://telemed:telemed@localhost:5433/telemed_doctor?sslmode=require
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# The dev stack now runs Redis with `requirepass telemed-dev-redis`
# (telemed-infra). This value must match it or every cache call fails with
# NOAUTH at boot.
#
# It is committed on purpose, following BANK_ENCRYPTION_KEY's precedent: an
# empty value here makes the documented `cp .env.example .env && make run`
# Quick Start fail, and a Quick Start that does not work is how a developer
# ends up running the stack with the control switched off. It is a DEV value
# and it is not safe anywhere else -- Redis holds OTP hashes and every
# rate-limit counter, so an unauthenticated Redis means `DEL
# otp:verify_attempts:*` removes the OTP brute-force cap.
#
# cache.Options treats this as an override on top of REDIS_URL, so a password
# embedded in the URL (redis://:pw@host) is replaced when this is set.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- NATS JetStream ---------------------------------------------------------
# The credentials go INSIDE the URL, and there is no alternative.
#
# NATS had no authorization block at all before the infra hardening (security
# review F30): anything that could open a TCP connection to :4222 could
# subscribe to `telemed.>` and read every domain event on the platform --
# appointment.created, consultation.*, payment.*, the lot.
#
# There is deliberately no NATS_USER / NATS_PASSWORD here. config.Base binds
# nats_url, nats_stream, nats_credentials and nats_max_bytes and nothing else,
# and events.NewNATS passes only o.URL to nats.Connect, which parses the
# userinfo out of it. Adding NATS_PASSWORD would bind to nothing and fail
# SILENTLY -- the service would connect anonymously and be refused, or worse,
# connect to a server that had not yet been hardened.
#
# NATS_CREDENTIALS is the other supported path (a .creds file, for NATS
# accounts/JWT) and is what a production deployment should use instead of
# userinfo in a URL.
NATS_URL=nats://telemed:telemed-dev-nats@localhost:4222
NATS_STREAM=TELEMED
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- Authentication ----------------------------------------------------------
# The platform has TWO token issuers and every service accepts both (ADR-010):
#   - telemed-user-service signs patient and doctor tokens. Phone-OTP login must
#     keep working when Keycloak is down, so it does not delegate signing.
#   - Keycloak signs admin tokens, where SAML SSO and enforced 2FA justify the
#     hard dependency.
# A token is accepted only if its signature verifies against one of these key
# sets AND its "iss" claim is on the trusted list. Verifying the signature alone
# would let the patient issuer mint an admin token.
# USER_ISSUER is the "iss" CLAIM VALUE user-service stamps into its tokens --
# it is NOT a URL and NOT the service base address. It must equal
# telemed-user-service's JWT_ISSUER exactly (default: telemed-user-service).
# Getting this wrong rejects every patient and doctor token with
# "untrusted token issuer" -- ADR-010's failure mode under a new cause.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs

# Comma-separated CIDRs whose X-Forwarded-For / X-Real-IP this service believes.
# Empty means the private ranges only (127/8, 10/8, 172.16/12, 192.168/16, ::1,
# fc00::/7) and NEVER the public internet. Rate limits and IP allowlists are
# only controls if the address they key on cannot be chosen by the caller.
TRUSTED_PROXIES=

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=30s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo

# --- Doctor service -----------------------------------------------------------
# 32-byte key (base64, standard encoding) for NaCl secretbox field-level
# encryption of doctor bank details. Generate with:
#   openssl rand -base64 32
# Rotate by adding a new key and re-encrypting; the Encryptor interface is the
# seam a future KMS-backed implementation replaces this through.
# A 32-byte key, BASE64-encoded (the code calls base64.StdEncoding.Decode --
# a hex string of the same length decodes to 48 bytes and is rejected).
# This DEV VALUE exists so `cp .env.example .env && make run` actually works;
# an empty value here makes the documented Quick Start fail at boot.
# Generate a real one for any shared environment: openssl rand -base64 32
BANK_ENCRYPTION_KEY=i9K3D/GaenYokaEwbNyev8CtDm87htGqiU7I9tNl3BE=

# Result pages are cached in Redis for this long, keyed by a hash of the
# normalised search query.
SEARCH_CACHE_TTL=60s

# --- scheduling-service -----------------------------------------------------
# Where scheduling-service listens. Used for exactly one thing: forwarding the
# `holidays` array on PUT /doctors/me/availability to the service that owns the
# holidays table (ADR-004 -- doctor-service must never write it).
#
# Leave it empty and an availability save carrying leave is refused with 501
# rather than accepted and dropped. A doctor told their leave was saved while
# patients keep booking them is the failure this path exists to prevent. Saves
# with no leave -- the common case -- never contact scheduling-service at all.
#
# Host port 8083, matching telemed-infra. In docker-compose use
# http://scheduling:8083.
SCHEDULING_BASE_URL=http://localhost:8083

# Bounds the holiday forward. It sits on a doctor's Save button, so it is short
# on purpose: a scheduling-service that is thinking for thirty seconds is one
# the doctor should be told about rather than watch a spinner for.
SCHEDULING_TIMEOUT=5s
