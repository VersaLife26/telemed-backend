# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.

SERVICE_NAME=telemed-payment-service
ENV=dev
HTTP_PORT=8085
GRPC_PORT=9095
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Port 5433, not 5432: telemed-infra publishes Postgres there so it does not
# clash with a host-level Postgres. Inside docker-compose, services reach it at
# postgres:5432 instead.
DATABASE_URL=postgres://telemed:telemed@localhost:5433/telemed_payment?sslmode=require
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# The dev value the infra stack sets with `requirepass`. It is NOT optional any
# more: Redis holds OTP hashes, every rate-limit counter and the suspension
# denylist, so an unauthenticated Redis means `DEL otp:verify_attempts:*`
# removes the OTP brute-force cap. If REDIS_URL already embeds a password this
# value wins -- cache.NewRedis overrides opt.Password whenever it is non-empty.
#
# Ordering matters: go-redis sends AUTH whenever this is non-empty, and a Redis
# WITHOUT requirepass answers AUTH with an error, so the service fails its
# startup ping. Set this only once telemed-infra's Redis actually requires a
# password; until then leave it empty.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- NATS JetStream ---------------------------------------------------------
# Credentials go INSIDE the URL. internal/platform/events reads only NATS_URL
# and nats.Connect parses the userinfo out of it -- there is no NATS_PASSWORD
# binding, so adding one would silently do nothing. NATS now carries an
# authorization{} block; before it, anything that could reach :4222 could
# subscribe to telemed.> and read every domain event on the platform.
NATS_URL=nats://telemed:telemed-dev-nats@localhost:4222
NATS_STREAM=TELEMED
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- Auth -------------------------------------------------------------------
# Two issuers, both trusted. user-service mints patient and doctor tokens so a
# phone-OTP login does not depend on Keycloak; Keycloak mints admin tokens.
# USER_ISSUER is the "iss" CLAIM VALUE user-service stamps into its tokens --
# it is NOT a URL and NOT the service base address. It must equal
# telemed-user-service's JWT_ISSUER exactly (default: telemed-user-service).
# Getting this wrong rejects every patient and doctor token with
# "untrusted token issuer" -- ADR-010's failure mode under a new cause.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=30s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo

# =============================================================================
# Payment rails
# =============================================================================
# Which rail a payment uses when the client does not name one.
PAYMENT_DEFAULT_PROVIDER=mock

# --- Mock rail (local development only) --------------------------------------
# A real implementation with real HMAC signing and a real replay window, so the
# verification path is exercised locally rather than skipped. The service
# refuses to start with this enabled when ENV=prod.
PAYMENT_ENABLE_MOCK=true
# Leave empty and one is generated at boot and logged nowhere; set it to script
# webhook deliveries against a running instance.
MOCK_WEBHOOK_SECRET=whsec_mock_local_development_only
# When true, CreateIntent settles immediately -- convenient while working on the
# booking flow, and wrong if you are working on the webhook flow.
MOCK_AUTO_SUCCEED=false
MOCK_FEE_BPS=300

# --- Stripe (cards, 3DS, Apple Pay, Google Pay) -------------------------------
# stripe-go v86. NOT v76 as the source documentation says; see ADR-001 and
# docs/DESIGN.md for what changed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Deliveries older than this are rejected as replays. Stripe's own default.
STRIPE_WEBHOOK_TOLERANCE=5m
# When true, an event whose API version is from a different Stripe release train
# than the SDK is rejected. Default false: our webhook parsing reads a handful
# of scalar fields with our own structs, so a skew is harmless, while refusing
# every webhook because the dashboard endpoint is pinned to last year's version
# is an outage.
STRIPE_STRICT_API_VERSION=false

# --- PayHere 2.0 (Sri Lankan cards and wallets) --------------------------------
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# The merchant REST API credentials, needed only for refunds. Separate from the
# checkout credentials above.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_NOTIFY_URL=https://api.versalifehealth.com/api/v1/webhooks/payhere
PAYHERE_RETURN_URL=https://patient.versalifehealth.com/appointments
PAYHERE_CANCEL_URL=https://patient.versalifehealth.com/appointments

# --- Dialog Ideamart carrier billing (charge to the phone bill) ---------------
# The rail that matters most in Sri Lanka: a large share of patients have a
# mobile account and no card.
DIALOG_PAY_APPLICATION_ID=
DIALOG_PAY_PASSWORD=
DIALOG_PAY_BASE_URL=https://api.ideamart.io
# Ideamart does not sign its callbacks. This is our own hardening: Dialog is
# configured to send an HMAC-SHA256 of the body, which we verify in constant
# time. Required unless the unsigned downgrade below is explicitly accepted.
DIALOG_PAY_WEBHOOK_SECRET=
DIALOG_PAY_WEBHOOK_TOLERANCE=5m
# Setting this to true leaves the Dialog webhook protected only by IP
# allowlisting. It is a real downgrade, it is logged as one on every boot, and
# it may not be set in production. It also may not be combined with
# DIALOG_WEBHOOK_SECRET: a configured secret is always required, and "secret
# set but header optional" is how a caller used to skip verification entirely
# by omitting the header.
DIALOG_PAY_ALLOW_UNSIGNED_WEBHOOKS=false
# The carrier's egress ranges, comma separated. REQUIRED whenever
# DIALOG_APPLICATION_ID is set: Ideamart signs nothing natively, so this is the
# compensating control the design depends on, and /webhooks/dialog fails CLOSED
# without it. Unlike ADMIN_IP_ALLOWLIST, empty does not mean "allow everything"
# -- the service refuses to boot. Set 0.0.0.0/0,::/0 to opt out explicitly and
# visibly in development.
DIALOG_PAY_WEBHOOK_CIDRS=

# =============================================================================
# Commission
# =============================================================================
# FIRST-BOOT SEED ONLY. Once commission_rules has any row, this is ignored --
# deliberately. Rates change by inserting a new rule version in the database so
# that an invoice reprinted in 2033 shows the 2026 rate. See docs/DESIGN.md.
#
# Shape: [{"default":true|"specialty":"GP"|"corporate_client":"AIA",
#          "commission":20, "provider_fee":3, "rounding":"half_up"}]
COMMISSION_RULES=[{"default":true,"commission":20,"provider_fee":3},{"specialty":"Cardiology","commission":25,"provider_fee":3},{"corporate_client":"AIA","commission":15,"provider_fee":3}]
# How long an active rule set is cached before it is reloaded.
COMMISSION_CACHE_TTL=5m
# Used only if no database rule matches at all: fail closed at a sane rate
# rather than open at zero commission.
COMMISSION_FALLBACK_BPS=2000
COMMISSION_FALLBACK_FEE_BPS=300

# =============================================================================
# Payouts
# =============================================================================
# 02:00 daily, evaluated in TIMEZONE through tzdata.
PAYOUT_SCHEDULE=0 2 * * *
# Captured money waits this long before it can be settled, so a same-day
# chargeback is caught before the funds leave.
PAYOUT_HOLD_PERIOD=24h
# The rail transfers are made over. PayHere and Dialog have no third-party
# payout API; leave this on stripe or mock.
PAYOUT_PROVIDER=mock
PAYOUT_MAX_DOCTORS_PER_RUN=500
# The cron scheduler starts in EVERY replica, deliberately -- a scheduler that
# runs in only one pod stops when that pod is rescheduled. Correctness comes
# from Postgres; the Redis lease below just keeps the pods from tripping over
# each other every night.
PAYOUT_SCHEDULER_ENABLED=true
# How long one replica may hold the settlement lease. It must comfortably
# outlive a real run: a lease that expires mid-run readmits a second replica to
# the job it exists to keep out. Minimum one minute, enforced at boot.
PAYOUT_LEASE_TTL=15m
# doctor_id -> rail account handle, as JSON. This service never stores bank
# details; it stores the opaque handle the rail issued. In a full deployment
# this becomes a lookup against doctor-service.
PAYOUT_ACCOUNTS={}

# =============================================================================
# Promotional codes
# =============================================================================
# How long an applied-but-unpaid code is held for the patient before anyone
# else may have it. It is also the ceiling on how stale a quote the rail can be
# handed: the hold is refreshed on every intent creation, so a charge can never
# outlive the reservation that justified its price.
PROMO_RESERVATION_TTL=30m
# How often abandoned holds are retired. This is a tidiness and reporting job,
# not a correctness dependency -- applying a code releases that code's own
# stale holds first, so a limited promotion is never permanently burned even
# if this never runs.
PROMO_SWEEP_INTERVAL=5m

# =============================================================================
# Carrier billing (Dialog) PIN challenges
# =============================================================================
# Must not exceed the carrier's own PIN lifetime (Ideamart documents about five
# minutes). Accepting a PIN the carrier has already forgotten fails at the
# debit with an opaque status code instead of failing here with "that code has
# expired, tap resend".
PIN_CHALLENGE_TTL=5m
# Guesses before the challenge, and the payment, fail. A four-digit PIN is
# 10,000 possibilities; three is the telco convention. Refused above 10.
PIN_MAX_ATTEMPTS=3
# PIN_MAX_ATTEMPTS is per CHALLENGE, and a challenge can be reopened: each
# POST /payments/dialog/request-pin supersedes the pending one and inserts a
# fresh row with the attempt counter back at zero. Without a resend bound the
# three guesses against a 4-digit PIN multiply by however many times the caller
# re-requests -- and every request drives a real carrier SMS to a phone number
# taken from the request body, which this service cannot check belongs to the
# caller (it does not hold the patient's number, by design).
PIN_MAX_RESENDS=5
PIN_RESEND_WINDOW=1h

# =============================================================================
# Saved payment methods
# =============================================================================
# Off by default. When false the /api/v1/payments/methods surface answers 501,
# which tells a client "this deployment does not do saved cards" rather than
# "something broke".
#
# NOTHING in this feature stores a card number or a CVV. The card is entered
# inside the provider's own SDK sheet on the handset; this service stores the
# opaque token the provider returns, plus brand/last4/expiry that the provider
# reports back. See migrations/000004_payment_methods.up.sql.
PAYMENT_METHODS_ENABLED=false
# The rail that holds the tokens. Only one rail can own the vault: a saved card
# is meaningless to a rail other than the one that tokenised it.
PAYMENT_METHODS_PROVIDER=stripe

# =============================================================================
# Invoices
# =============================================================================
INVOICE_COMPANY_NAME=Telemed Lanka (Pvt) Ltd
INVOICE_ADDRESS=Level 5, Colombo 03, Sri Lanka
INVOICE_TAX_ID=
INVOICE_EMAIL=billing@telemed.lk
INVOICE_PHONE=+94112345678

# --- Network trust ----------------------------------------------------------
# Comma-separated CIDRs whose X-Forwarded-For header we believe. Empty means
# the private ranges only, never the public internet. This matters here more
# than in most services: the webhook routes are unauthenticated and rate limited
# by client IP, so an IP an attacker can choose is a limiter they can bypass.
TRUSTED_PROXIES=
