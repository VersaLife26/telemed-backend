# Copy to .env for local development: cp .env.example .env
# Every value here is a development default. Nothing in this file is a secret,
# and nothing in this file is safe to deploy.

SERVICE_NAME=telemed-notification-service
ENV=dev
HTTP_PORT=8086
GRPC_PORT=9096
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Port 5433, not 5432: telemed-infra publishes Postgres on the host at 5433
# so it does not clash with a host-level Postgres already occupying 5432.
# Inside docker-compose, services still reach it at postgres:5432. See
# telemed-infra/README.md and _shared/INTEGRATION-FIXES.md item 1.
# EVERY environment connects as telemed_notification_app: the least-privilege
# runtime role. It owns nothing, so it cannot DROP, ALTER, disable a trigger or
# TRUNCATE, and it has no CONNECT privilege on any other service's database --
# so a credential leaked from here is worthless against telemed_record
# (security review F14). Migrations run separately as
# telemed_notification_migrate, which owns the schema: `make migrate-up`.
# Both roles are created by telemed-infra's Postgres init on first boot; see
# telemed-infra/docs/DATABASE-ROLES.md.
DATABASE_URL=postgres://telemed_notification_app:telemed@localhost:5433/telemed_notification?sslmode=require
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFE=1h

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# The dev value the infra stack sets with `requirepass`. It is NOT optional any
# more: Redis holds OTP hashes, every rate-limit counter and the suspension
# denylist, so an unauthenticated Redis means `DEL otp:verify_attempts:*`
# removes the OTP brute-force cap. If REDIS_URL already embeds a password this
# value wins -- cache.NewRedis overrides opt.Password whenever it is non-empty.
#
# Ordering matters: go-redis sends AUTH whenever this is non-empty, and a Redis
# WITHOUT requirepass answers AUTH with an error, so the service fails its
# startup ping. Set this only once telemed-infra's Redis actually requires a
# password; until then leave it empty.
REDIS_PASSWORD=telemed-dev-redis
REDIS_DB=0

# --- NATS JetStream ---------------------------------------------------------
# Credentials go INSIDE the URL. internal/platform/events reads only NATS_URL
# and nats.Connect parses the userinfo out of it -- there is no NATS_PASSWORD
# binding, so adding one would silently do nothing. NATS now carries an
# authorization{} block; before it, anything that could reach :4222 could
# subscribe to telemed.> and read every domain event on the platform.
NATS_URL=nats://telemed:telemed-dev-nats@localhost:4222
NATS_STREAM=TELEMED
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100

# --- Authentication: TWO issuers, both trusted (ADR-010) ---------------------
# telemed-user-service signs patient and doctor tokens -- phone-OTP login must
# keep working when Keycloak is down. Keycloak signs admin tokens, where SAML
# SSO and enforced 2FA justify the hard dependency.
#
# A token is accepted only when its signature verifies against ONE of these key
# sets AND its "iss" claim is on the trusted list. Configuring Keycloak alone
# rejects every patient and doctor token with a signature error.
#
# USER_ISSUER is the literal "iss" claim user-service mints -- its JWT_ISSUER,
# NOT its base URL. Change it here only if you change it there.
USER_ISSUER=telemed-user-service
USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
KEYCLOAK_ISSUER=http://localhost:8180/realms/telemedicine
KEYCLOAK_AUDIENCE=telemed-api
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/telemedicine/protocol/openid-connect/certs

# --- Client IP resolution (security) -----------------------------------------
# CIDRs whose X-Forwarded-For / X-Real-IP headers are believed. Requests from
# anywhere else have their client address taken from the TCP peer, which no
# header can forge. chi's middleware.RealIP is deprecated for exactly this
# reason (GHSA-3fxj-6jh8-hvhx) and the admin IP allowlist depends on the value.
# Empty means "private ranges only" (127/8, ::1, 10/8, 172.16/12, 192.168/16,
# fc00::/7). In production, set your ingress/load-balancer ranges explicitly.
TRUSTED_PROXIES=

# --- Observability ----------------------------------------------------------
# Leave OTLP_ENDPOINT empty to disable tracing entirely (no collector needed).
OTLP_ENDPOINT=
TRACE_SAMPLING=1.0

# --- Runtime ----------------------------------------------------------------
SHUTDOWN_GRACE=20s
REQUEST_TIMEOUT=30s
# Business timezone. Resolved through tzdata, never a fixed offset.
TIMEZONE=Asia/Colombo

# --- Notification providers (ADR-002: config-driven, per-channel) ----------
# Each of these is "console", "direct" (FCM/Dialog-or-Twilio/SMTP), or "novu".
#
# "console" is a LOCAL DEVELOPMENT provider: it delivers nothing and prints
# what would have been sent, which is what lets `docker compose up` boot with
# no credentials at all. With ENV=prod the service now REFUSES TO BOOT if any
# channel resolves to it, whether from an empty value or a typo (security
# review F20c). It used to fall back silently, which meant one misspelling in
# these three variables was an invisible, total outage of the channel patients
# rely on for appointment reminders -- while every message was recorded as
# delivered.
#
# The console provider prints the recipient address and the rendered body only
# when ENV is dev or development. In staging it registers but withholds
# content: a staging environment fed from a production-shaped dataset has the
# same patients in it.
NOTIFICATION_SMS_PROVIDER=console
NOTIFICATION_PUSH_PROVIDER=console
NOTIFICATION_EMAIL_PROVIDER=console
# Which direct SMS transport to use when NOTIFICATION_SMS_PROVIDER=direct.
NOTIFICATION_SMS_BACKEND=dialog

# --- Direct: Dialog Ideamart SMS (Sri Lanka, requires TRCSL approval) ------
DIALOG_BASE_URL=
DIALOG_APPLICATION_ID=
DIALOG_PASSWORD=
DIALOG_SOURCE_ADDRESS=

# --- Direct: Twilio SMS (international fallback) --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Direct: FCM HTTP v1 push ----------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Direct: SMTP email (also covers AWS SES via its SMTP interface) ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.lk

# --- Novu (optional, per ADR-002 -- not required for the direct provider) -
NOVU_BASE_URL=https://api.novu.co
NOVU_API_KEY=
NOVU_WORKFLOW_SMS=
NOVU_WORKFLOW_PUSH=
NOVU_WORKFLOW_EMAIL=

# --- Delivery webhooks ---------------------------------------------------
# POST /webhooks/delivery/{provider} applies a provider's delivery or bounce
# callback. It carries no platform JWT -- providers do not hold our bearer
# tokens -- so it is authenticated by a shared secret placed in the callback
# URL you configure at the provider, or in an X-Telemed-Webhook-Token header.
#
# This is not optional and has no useful default: without it the route is an
# unauthenticated UPDATE of any notification row found by provider_message_id,
# which is a Twilio SID or an FCM message id -- guessable, and shorter than a
# UUID. Boot fails if it is empty or shorter than 24 characters.
#
# Generate one with: openssl rand -hex 32
# Then set the provider callback to
#   https://api.yourapp.lk/webhooks/delivery/twilio?token=<this value>
NOTIFICATION_WEBHOOK_SECRET=dev-only-notification-webhook-secret-change-me

# --- Recipient resolution ----------------------------------------------------
# Where a recipient's phone and email come from. The canonical event payloads
# deliberately do not carry them: a phone number is PHI-adjacent and those
# events fan out to every consumer on the platform, so they are fetched per
# person over user-service's internal gRPC surface at enqueue time (never on
# the delivery path). Required -- a notification service that cannot address a
# message is broken, not degraded.
USER_SERVICE_GRPC_ADDR=localhost:9091
# This gRPC hop carries names, phone numbers and email addresses. It has always
# been plaintext, justified by "the mesh is private" -- true of a single-host
# compose deployment, and a reasonable position, but it was the only position
# available.
#
# It is now a decision. Plaintext remains the default so the current deployment
# keeps working, but a PRODUCTION service refuses to boot on plaintext unless
# USER_SERVICE_GRPC_ALLOW_PLAINTEXT is set deliberately: an unset variable must
# not silently mean unencrypted PII across the cluster (that is F17's shape).
#
# mTLS is deliberately out of scope: it needs a CA and a rotation story that do
# not exist yet, and user-service presents no gRPC server credentials.
# Server-authenticated TLS is what this side can deliver alone, and it closes
# passive interception.
USER_SERVICE_GRPC_TLS=false
USER_SERVICE_GRPC_CA_FILE=
USER_SERVICE_GRPC_SERVER_NAME=
USER_SERVICE_GRPC_ALLOW_PLAINTEXT=false
USER_LOOKUP_TIMEOUT_SECONDS=3

# Public origin used to build every deep link in a message body (join a
# consultation, download a prescription, view a receipt). These used to arrive
# as join_link/download_url/receipt_url fields on five different events; a URL
# scheme is this service's business, not five producers'.
PUBLIC_APP_BASE_URL=http://localhost:3000
DOCTOR_PORTAL_BASE_URL=http://localhost:3001
# Ops inbox for new doctor applications (email). Empty skips the ops email.
DOCTOR_APPLICATIONS_NOTIFY_EMAIL=

# --- Delivery pipeline tuning ------------------------------------------------
DISPATCH_INTERVAL_SECONDS=2
DISPATCH_BATCH_SIZE=50
REMINDER_INTERVAL_SECONDS=60
MAINTENANCE_INTERVAL_HOURS=24
NOTIFICATION_BODY_RETENTION_DAYS=90
DEVICE_TOKEN_RETENTION_DAYS=30
MAX_SEND_ATTEMPTS=6
SEND_BACKOFF_BASE_SECONDS=30
SEND_BACKOFF_MAX_MINUTES=30
