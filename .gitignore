# build output
bin/
dist/
*.exe
# `go build` with no -o drops the binary here, named after the module. 85 MB of
# it, which git would keep forever.
/telemed

# local configuration and secrets -- never committed
.env
.env.local
*.pem
*.key
!testdata/*.key

# local object storage (STORAGE_BACKEND=filesystem)
data/

# test artefacts
coverage.out
coverage.html
*.test

# editor
.idea/
.vscode/
*.swp
.DS_Store

# generated docs
docs/openapi/docs.go
docs/openapi/swagger.json
